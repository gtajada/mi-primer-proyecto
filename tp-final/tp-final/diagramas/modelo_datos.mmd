    int fecha_id FK
    string canal_id FK
    string promo_id FK
    int unidades
    decimal monto_neto
  }
  FACT_STOCK_DIARIO {
    string sku_id PK
    string local_id PK
    int fecha_id PK
    int stock_unidades
